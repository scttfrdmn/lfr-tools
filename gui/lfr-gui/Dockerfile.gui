# Multi-stage build for LFR Tools GUI
FROM node:18-alpine AS frontend-build

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci --only=production

COPY frontend/ ./
RUN npm run build

FROM golang:1.22-alpine AS backend-build

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend-build /frontend/dist ./frontend/dist

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o lfr-gui .

FROM alpine:latest

RUN apk --no-cache add ca-certificates openssh-client
WORKDIR /root/

COPY --from=backend-build /app/lfr-gui .

# Create necessary directories
RUN mkdir -p ~/.ssh ~/.lfr-tools

EXPOSE 8080

CMD ["./lfr-gui"]